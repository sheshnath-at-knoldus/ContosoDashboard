@page "/"
@using ContosoDashboard.Services
@using ContosoDashboard.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDashboardService DashboardService
@inject INotificationService NotificationService
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>Welcome, @userName!</h1>
            <p class="text-muted">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>
        </div>
    </div>

    @if (summary != null)
    {
        <div class="row mb-4">
            <div class="col-md-3 mb-3">
                <div class="card summary-card">
                    <div class="card-body">
                        <h5 class="card-title">Active Tasks</h5>
                        <p class="card-text display-4">@summary.TotalActiveTasks</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card summary-card">
                    <div class="card-body">
                        <h5 class="card-title">Due Today</h5>
                        <p class="card-text display-4 text-warning">@summary.TasksDueToday</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card summary-card">
                    <div class="card-body">
                        <h5 class="card-title">Active Projects</h5>
                        <p class="card-text display-4 text-info">@summary.ActiveProjects</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card summary-card">
                    <div class="card-body">
                        <h5 class="card-title">Notifications</h5>
                        <p class="card-text display-4 text-danger">@summary.UnreadNotifications</p>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (announcements != null && announcements.Any())
    {
        <div class="row mb-4">
            <div class="col">
                <h3>Announcements</h3>
                @foreach (var announcement in announcements)
                {
                    <div class="card mb-3 announcement-card">
                        <div class="card-body">
                            <h5 class="card-title">@announcement.Title</h5>
                            <p class="card-text">@announcement.Content</p>
                            <small class="text-muted">
                                Posted by @announcement.CreatedByUser.DisplayName on @announcement.PublishDate.ToString("MMM dd, yyyy")
                            </small>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (isAdmin && activityReport != null)
    {
        <div class="row mb-4">
            <div class="col-md-12">
                <h3>Document Activity (Admin)</h3>
                <div class="row mb-3">
                    <div class="col-md-3 mb-3">
                        <div class="card summary-card">
                            <div class="card-body">
                                <h5 class="card-title">Total Documents</h5>
                                <p class="card-text display-4">@activityReport.TotalDocuments</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="card summary-card">
                            <div class="card-body">
                                <h5 class="card-title">Active Uploaders</h5>
                                <p class="card-text display-4 text-info">@activityReport.ActiveUploaderCount</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="card summary-card">
                            <div class="card-body">
                                <h5 class="card-title">Storage Used</h5>
                                <p class="card-text display-4 text-warning">@FormatBytes(activityReport.TotalStorageBytes)</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="card summary-card">
                            <div class="card-body">
                                <h5 class="card-title">Recorded Events</h5>
                                <p class="card-text display-4 text-success">@activityReport.AccessEventsByType.Values.Sum()</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <h6>By Category</h6>
                        <ul class="list-group">
                            @foreach (var item in activityReport.DocumentsByCategory)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>@item.Key</span>
                                    <span class="badge bg-secondary">@item.Value</span>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="col-md-4 mb-3">
                        <h6>By File Type</h6>
                        <ul class="list-group">
                            @foreach (var item in activityReport.DocumentsByFileType)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>@item.Key</span>
                                    <span class="badge bg-secondary">@item.Value</span>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="col-md-4 mb-3">
                        <h6>Top Uploaders</h6>
                        <ul class="list-group">
                            @foreach (var uploader in activityReport.TopUploaders)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>@uploader.DisplayName</span>
                                    <span class="badge bg-secondary">@uploader.DocumentCount</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <h6>By Status</h6>
                        <ul class="list-group">
                            @foreach (var item in activityReport.DocumentsByStatus)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>@item.Key</span>
                                    <span class="badge bg-secondary">@item.Value</span>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="col-md-6 mb-3">
                        <h6>Access Patterns (Audit Events)</h6>
                        <ul class="list-group">
                            @foreach (var item in activityReport.AccessEventsByType)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>@item.Key</span>
                                    <span class="badge bg-secondary">@item.Value</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (recentDocuments != null && recentDocuments.Any())
    {
        <div class="row mb-4">
            <div class="col-md-12">
                <h3>Recent Documents</h3>
                <div class="list-group">
                    @foreach (var doc in recentDocuments)
                    {
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@doc.Title</strong>
                                    <div class="text-muted small">@doc.Category · @doc.UploadedByUser.DisplayName</div>
                                </div>
                                <span class="badge bg-@GetDocumentStatusColor(doc.Status)">@doc.Status</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <h3>Quick Actions</h3>
            <div class="list-group">
                <a href="/tasks" class="list-group-item list-group-item-action">
                    <i class="bi bi-check2-square"></i> View My Tasks
                </a>
                <a href="/projects" class="list-group-item list-group-item-action">
                    <i class="bi bi-folder"></i> View My Projects
                </a>
                <a href="/documents" class="list-group-item list-group-item-action">
                    <i class="bi bi-file-earmark-text"></i> View Documents
                </a>
                <a href="/notifications" class="list-group-item list-group-item-action">
                    <i class="bi bi-bell"></i> View Notifications
                </a>
                <a href="/profile" class="list-group-item list-group-item-action">
                    <i class="bi bi-person"></i> Edit Profile
                </a>
            </div>
        </div>

        <div class="col-md-6">
            <h3>Recent Notifications</h3>
            @if (recentNotifications != null && recentNotifications.Any())
            {
                <div class="list-group">
                    @foreach (var notification in recentNotifications.Take(5))
                    {
                        <div class="list-group-item @(!notification.IsRead ? "bg-light" : "")">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">@notification.Title</h6>
                                <small>@GetRelativeTime(notification.CreatedDate)</small>
                            </div>
                            <p class="mb-1">@notification.Message</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No recent notifications</p>
            }
        </div>
    </div>
</div>

@code {
    private DashboardSummary? summary;
    private List<Announcement>? announcements;
    private List<Notification>? recentNotifications;
    private List<Document>? recentDocuments;
    private DocumentActivityReport? activityReport;
    private string userName = "User";
    private int currentUserId = 0;
    private bool isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        // Get the current user from authentication
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userName = user.Identity?.Name ?? "User";
        isAdmin = user.IsInRole(nameof(UserRole.Administrator));

        // Get user ID from claims
        var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
            currentUserId = userId;
        }

        if (currentUserId > 0)
        {
            summary = await DashboardService.GetDashboardSummaryAsync(currentUserId);
            announcements = await DashboardService.GetActiveAnnouncementsAsync();
            recentNotifications = await NotificationService.GetUserNotificationsAsync(currentUserId);
            recentDocuments = await DocumentService.GetRecentDocumentsAsync(currentUserId, 5);

            if (isAdmin)
            {
                activityReport = await DocumentService.GetDocumentActivityReportAsync(currentUserId);
            }
        }
    }

    private string GetRelativeTime(DateTime dateTime)
    {
        var timeSpan = DateTime.UtcNow - dateTime;

        if (timeSpan.TotalMinutes < 1)
            return "Just now";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes} min ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours} hours ago";
        if (timeSpan.TotalDays < 7)
            return $"{(int)timeSpan.TotalDays} days ago";

        return dateTime.ToString("MMM dd, yyyy");
    }

    private string GetDocumentStatusColor(DocumentStatus status)
    {
        return status switch
        {
            DocumentStatus.PendingScan => "warning",
            DocumentStatus.Approved => "success",
            DocumentStatus.Rejected => "danger",
            DocumentStatus.Quarantined => "dark",
            _ => "secondary"
        };
    }

    private string FormatBytes(long bytes)
    {
        const long kb = 1024;
        const long mb = kb * 1024;
        const long gb = mb * 1024;

        if (bytes >= gb)
            return $"{bytes / (double)gb:F1} GB";
        if (bytes >= mb)
            return $"{bytes / (double)mb:F1} MB";
        if (bytes >= kb)
            return $"{bytes / (double)kb:F1} KB";
        return $"{bytes} B";
    }
}
